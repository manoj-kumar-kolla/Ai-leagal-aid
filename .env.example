# ─────────────────────────────────────────────────────────────
#  Ala — AI Legal Assistant for India
#  Environment variable template
#
#  USAGE:
#    1. Copy this file:   cp .env.example .env
#    2. Open .env and fill in your actual values.
#    3. NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────
# Get a FREE key at: https://console.groq.com → API Keys → Create
GROQ_API_KEY=paste_your_groq_api_key_here

# ── OPTIONAL — Model (default shown) ────────────────────────
# See all available models: https://console.groq.com/docs/models
# GROQ_MODEL=qwen/qwen3-8b

# ── OPTIONAL — Response tuning ──────────────────────────────
# TEMPERATURE=0.2       # 0.0 = most deterministic, 2.0 = most creative
# MAX_TOKENS=4096       # Maximum length of a single response

# ── OPTIONAL — RAG retrieval ────────────────────────────────
# RAG_TOP_K=5           # Number of law sections retrieved per query (1–20)

# ── OPTIONAL — Safety limits ────────────────────────────────────────
# MAX_HISTORY_TURNS=20  # Max conversation turns kept in memory (2–100)
# MAX_INPUT_CHARS=4000  # Max characters accepted per user message

# ── OPTIONAL — IndianKanoon live case law ────────────────────────────
# Get a FREE trial (Rs.500 credit) at: https://api.indiankanoon.org/
# Non-commercial projects can apply for Rs.10,000/month free credit.
# Leave blank to disable live case law search (BM25 RAG still works).
# INDIANKANOON_API_TOKEN=paste_your_indiankanoon_token_here

# ── OPTIONAL — Language detection ────────────────────────────────────
# Ala auto-detects Hindi, Telugu, Tamil, Bengali, Marathi, Kannada,
# Malayalam, Gujarati, Punjabi, Odia, Urdu and responds in that language.
# Set to "false" to always respond in English.
# LANGUAGE_DETECTION_ENABLED=true
